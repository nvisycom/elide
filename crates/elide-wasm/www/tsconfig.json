{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,

    // Type resolution for the `elide-wasm` import, mirroring the Vite alias.
    "paths": {
      "elide-wasm": ["./pkg/elide_wasm.d.ts"]
    }
  },

  "include": ["src", "vite.config.ts"]
}
